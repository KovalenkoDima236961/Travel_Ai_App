RABBITMQ_MANAGEMENT_USER=travelai
RABBITMQ_MANAGEMENT_PASSWORD=change_me_alpha_rabbitmq_password_32_bytes_min

JWT_ACCESS_SECRET=change_me_alpha_jwt_access_secret_32_bytes_min
