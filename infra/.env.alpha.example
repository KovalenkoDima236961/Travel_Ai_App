# Closed alpha profile. Copy to infra/.env.alpha and replace every change_me
# value with a managed secret before use. The runtime environment remains
# APP_ENV=staging because service configs support local/test/staging/production.
APP_ENV=staging
ALPHA_RELEASE_PROFILE=closed-alpha-v1
FEATURE_FLAG_PROFILE_PATH=config/feature-flags/alpha.json
# Used by infra/docker-compose.prod.yml env_file entries. Keep relative to infra/
# when using the normal infra/.env.alpha file.
TRAVEL_AI_ENV_FILE=.env.alpha
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_ALPHA_RELEASE_LABEL=Alpha
ALPHA_SUPPORT_URL=/settings
ALPHA_FEEDBACK_URL=/settings

APP_VERSION=0.1.0
GIT_SHA=unknown
BUILD_TIME=unknown
IMAGE_REGISTRY=travel-ai
IMAGE_TAG=0.1.0
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_GIT_SHA=unknown
NEXT_PUBLIC_BUILD_TIME=unknown

POSTGRES_DB=trip_service
POSTGRES_USER=travelai
POSTGRES_PASSWORD=change_me_alpha_postgres_password_32_bytes_min
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONNS=12
DATABASE_URL=postgres://travelai:change_me_alpha_postgres_password_32_bytes_min@postgres:5432/trip_service?sslmode=disable
AUTH_POSTGRES_DB=auth_service
USER_POSTGRES_DB=user_service
NOTIFICATION_POSTGRES_DB=notification_service
EXTERNAL_INTEGRATIONS_POSTGRES_DB=external_integrations_service
AUTH_DATABASE_URL=postgres://travelai:change_me_alpha_postgres_password_32_bytes_min@postgres:5432/auth_service?sslmode=disable
USER_DATABASE_URL=postgres://travelai:change_me_alpha_postgres_password_32_bytes_min@postgres:5432/user_service?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://travelai:change_me_alpha_postgres_password_32_bytes_min@postgres:5432/notification_service?sslmode=disable

RABBITMQ_USER=travelai
RABBITMQ_PASSWORD=change_me_alpha_rabbitmq_password_32_bytes_min
RABBITMQ_URL=amqp://travelai:change_me_alpha_rabbitmq_password_32_bytes_min@rabbitmq:5672/
