{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Fine-Tuning Experiment Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experimentKey",
    "taskType",
    "method",
    "baseModelName",
    "datasetPath",
    "datasetVersion"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "experimentKey": { "type": "string", "minLength": 3 },
    "taskType": { "const": "grounded_itinerary_generation" },
    "method": { "enum": ["lora", "qlora"] },
    "baseModelName": { "type": "string", "minLength": 1 },
    "baseModelRevision": { "type": "string", "default": "main" },
    "baseModelFamily": { "type": "string", "default": "llama" },
    "baseModelLicense": { "type": "string", "default": "record-before-training" },
    "datasetPath": { "type": "string", "minLength": 1 },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "outputDir": { "type": "string", "default": "artifacts/ai-training" },
    "seed": { "type": "integer", "minimum": 0, "default": 42 },
    "maxSeqLength": { "type": "integer", "minimum": 128, "default": 4096 },
    "trainBatchSize": { "type": "integer", "minimum": 1, "default": 1 },
    "evalBatchSize": { "type": "integer", "minimum": 1, "default": 1 },
    "gradientAccumulationSteps": { "type": "integer", "minimum": 1, "default": 16 },
    "numTrainEpochs": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
    "learningRate": { "type": "number", "exclusiveMinimum": 0, "default": 0.0002 },
    "warmupRatio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.03 },
    "weightDecay": { "type": "number", "minimum": 0, "default": 0 },
    "loraR": { "type": "integer", "minimum": 1, "default": 16 },
    "loraAlpha": { "type": "integer", "minimum": 1, "default": 32 },
    "loraDropout": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.05 },
    "targetModules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "quantizationBits": { "enum": [4, 8], "default": 4 },
    "gradientCheckpointing": { "type": "boolean", "default": true },
    "allowHoldoutTraining": { "const": false },
    "dryRun": { "type": "boolean", "default": false },
    "cpuSmoke": { "type": "boolean", "default": false },
    "promotionGates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minSchemaValidRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "minFactualPrecision": { "type": "number", "minimum": 0, "maximum": 1 },
        "minGroundingCitationRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "minNoPiiRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxCostRegressionPct": { "type": "number", "minimum": 0 },
        "maxLatencyRegressionPct": { "type": "number", "minimum": 0 }
      }
    }
  }
}
