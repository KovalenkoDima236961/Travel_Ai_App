{
  "$schema": "./config.schema.json",
  "experimentKey": "grounded-itinerary-local-v1",
  "taskType": "grounded_itinerary_generation",
  "method": "qlora",
  "baseModelName": "meta-llama/Meta-Llama-3.1-8B-Instruct",
  "baseModelRevision": "main",
  "baseModelFamily": "llama",
  "baseModelLicense": "record-before-training",
  "datasetPath": "../../data/ai-datasets/example-export",
  "datasetVersion": "v1",
  "outputDir": "../../data/model-adapters",
  "seed": 42,
  "maxSeqLength": 4096,
  "trainBatchSize": 1,
  "evalBatchSize": 1,
  "gradientAccumulationSteps": 16,
  "numTrainEpochs": 1,
  "learningRate": 0.0002,
  "warmupRatio": 0.03,
  "weightDecay": 0,
  "loraR": 16,
  "loraAlpha": 32,
  "loraDropout": 0.05,
  "targetModules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "quantizationBits": 4,
  "gradientCheckpointing": true,
  "allowHoldoutTraining": false,
  "dryRun": true,
  "cpuSmoke": false,
  "promotionGates": {
    "minSchemaValidRate": 0.99,
    "minFactualPrecision": 0.92,
    "minGroundingCitationRate": 0.95,
    "minNoPiiRate": 1,
    "maxCostRegressionPct": 10,
    "maxLatencyRegressionPct": 25
  }
}
