# AI Planning Service environment example.
# Copy to .env for local shell usage, then load it with:
#   set -a; source .env; set +a

APP_ENV=local
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
LOG_LEVEL=INFO

# Provider selection. Supported values: mock, ollama, openai.
# mock is deterministic and requires no Ollama instance.
AI_MODEL_PROVIDER=mock
AI_MODEL_PROVIDER_FALLBACK=none
AI_MODEL_PROVIDER_FALLBACK_ENABLED=true
ITINERARY_GENERATOR_MODE=mock
COPILOT_MODE=mock
TRIP_RECAP_AI_MODE=mock

# AI template adaptation (/adapt-template). Mode defaults to mock when unset.
AI_TEMPLATE_ADAPTATION_ENABLED=true
AI_TEMPLATE_ADAPTATION_MODE=mock
AI_TEMPLATE_ADAPTATION_TIMEOUT_SECONDS=120
AI_TEMPLATE_ADAPTATION_FALLBACK_ENABLED=true

# For local Ollama, use http://127.0.0.1:11434.
# In Docker Compose, use http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=2048
OLLAMA_FALLBACK_TO_MOCK=true
OLLAMA_REPAIR_ENABLED=true
OLLAMA_REPAIR_ATTEMPTS=1
LOG_LLM_PAYLOADS=false

# OpenAI provider. Keep disabled for local/CI unless explicitly testing real
# calls. Never expose OPENAI_API_KEY through NEXT_PUBLIC_* variables.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TIMEOUT_SECONDS=90
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_INITIAL_DELAY_MS=500
OPENAI_RETRY_MAX_DELAY_MS=5000
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_STORE_RESPONSES=false
OPENAI_MODEL_DEFAULT=
OPENAI_MODEL_ITINERARY=
OPENAI_MODEL_REGENERATION=
OPENAI_MODEL_REPAIR=
OPENAI_MODEL_DISCOVERY=
OPENAI_MODEL_ROUTE_ALTERNATIVES=
OPENAI_MODEL_BUDGET_OPTIMIZATION=
OPENAI_MODEL_CHECKLIST=
OPENAI_MODEL_COPILOT=
OPENAI_MODEL_RECAP=
OPENAI_MODEL_EVALUATION=
OPENAI_USAGE_TRACKING_ENABLED=true
OPENAI_COST_TRACKING_ENABLED=true
OPENAI_DAILY_SPEND_LIMIT_UAH=
OPENAI_MONTHLY_SPEND_LIMIT_UAH=
OPENAI_PER_USER_DAILY_GENERATION_LIMIT=
OPENAI_PER_TRIP_DAILY_GENERATION_LIMIT=
OPENAI_PER_USER_COPILOT_REQUESTS_PER_MINUTE=10
OPENAI_PER_USER_DISCOVERY_REQUESTS_PER_DAY=20
OPENAI_MAX_CONCURRENT_REQUESTS=5
OPENAI_MAX_INPUT_TOKENS=
OPENAI_MAX_CONTEXT_BYTES=
OPENAI_MAX_GROUNDING_PLACES=
OPENAI_MAX_GROUNDING_DOCUMENTS=
OPENAI_REPAIR_ENABLED=true
OPENAI_MAX_REPAIR_ATTEMPTS=1
OPENAI_REPAIR_TIMEOUT_SECONDS=60
OPENAI_BATCH_ENABLED=false
OPENAI_BATCH_MODEL=
OPENAI_BATCH_MAX_REQUESTS=
OPENAI_BATCH_OUTPUT_DIR=

# Local fine-tuning and adapter inference are disabled by default.
AI_FINE_TUNING_EXPERIMENTS_ENABLED=false
AI_ADAPTER_INFERENCE_ENABLED=false
AI_ADAPTER_STAGING_ENABLED=false
AI_ADAPTER_ENABLED=false
AI_ADAPTER_PATH=
AI_ADAPTER_KEY=
AI_ADAPTER_CHECKSUM=
AI_ADAPTER_EXPERIMENT_KEY=
AI_ADAPTER_DATASET_VERSION=
AI_ADAPTER_FALLBACK_TO_BASE=true
AI_ADAPTER_STRICT_LOAD=true
AI_MODEL_VARIANT=grounded_baseline
AI_MODEL_LOAD_TIMEOUT_SECONDS=120
AI_MODEL_ARTIFACT_DIR=app/data/model-adapters

DESTINATION_CONTEXT_ENABLED=true
DESTINATION_CONTEXT_DIR=app/data/destinations

# Local-document RAG v1. Disabled by default.
RAG_ENABLED=false
RAG_KNOWLEDGE_DIR=app/data/knowledge
KNOWLEDGE_CURATED_DIR=app/data/travel-knowledge
RAG_CHROMA_DIR=app/data/chroma
RAG_COLLECTION_NAME=travel_knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
KNOWLEDGE_INDEXING_ENABLED=true
KNOWLEDGE_INDEX_BATCH_SIZE=50
KNOWLEDGE_INDEX_FAIL_OPEN=true
ANONYMIZED_TELEMETRY=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=30
